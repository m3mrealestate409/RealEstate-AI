# ==========================================================================
#  Chaahat Homes AI Knowledge Engine — Environment Configuration
#  Copy this file to `.env` and fill in real values.
#  NOTHING here is ever exposed to the frontend. Keys stay server-side only.
# ==========================================================================

# --- App ---
# For production set APP_ENV=production (this enables strict startup checks:
# a strong SECRET_KEY and non-default seed passwords become mandatory).
APP_ENV=development
APP_DEBUG=true
# MUST be a unique 32+ char random string in production. The app refuses to boot
# in production with a weak/default value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Production CORS allow-list (comma-separated). Used only when APP_DEBUG=false.
# e.g. CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=

# --- Database (compose overrides host to `db`) ---
POSTGRES_USER=chaahat
POSTGRES_PASSWORD=chaahat_pass
POSTGRES_DB=chaahat_engine
DATABASE_URL=postgresql+psycopg://chaahat:chaahat_pass@localhost:5432/chaahat_engine

# --- Redis (session memory) ---
REDIS_URL=redis://localhost:6379/0

# ==========================================================================
#  LLM PROVIDER LAYER  (Constitution §12 — swap provider by config only)
#  Supported: mock | gemini | claude | openai | openrouter | ollama
#  Leave as `mock` to run the whole engine WITHOUT any API key.
# ==========================================================================
LLM_PROVIDER=mock
# flash-lite = "thinking" off by default → faster + cheaper (recommended for this engine).
LLM_MODEL=gemini-flash-lite-latest

# Paste your Gemini key here when you want real AI answers.
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# (future providers — leave blank until used)
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================================================
#  EMBEDDINGS  (for RAG vector search)
#  Provider: mock | gemini
#  `mock` = deterministic local embeddings, no API needed (dev/testing).
#  Dimension MUST match the vector column (768 = Gemini text-embedding-004).
# ==========================================================================
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- RAG tuning ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# --- Default seed admin (created on first boot) ---
# In production these MUST NOT be the demo defaults (admin123/owner123) — the
# seeder refuses to run with default passwords when APP_ENV=production.
SEED_ADMIN_EMAIL=admin@chaahat.local
SEED_ADMIN_PASSWORD=admin123
SEED_SUPER_ADMIN_EMAIL=owner@engine.local
SEED_SUPER_ADMIN_PASSWORD=owner123
