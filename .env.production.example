# ==========================================================================
#  PropX Estate — PRODUCTION Environment Template
#  Copy to `.env` on the server and fill EVERY placeholder below.
#  Deploy with:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#  NOTHING here is exposed to the frontend. Secrets stay server-side only.
# ==========================================================================

# --- App ---------------------------------------------------------------
# production turns on strict startup checks: the app REFUSES to boot with a
# weak SECRET_KEY, and the seeder refuses default demo passwords.
APP_ENV=production
APP_DEBUG=false

# REQUIRED. 32+ chars, high entropy. The app will not start otherwise.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480

# REQUIRED in production. Comma-separated list of the exact origins that serve
# your app / embed the widget. No trailing slash.
#   e.g. CORS_ORIGINS=https://app.propxestate.com,https://www.clientsite.com
CORS_ORIGINS=

# --- Database ----------------------------------------------------------
# REQUIRED. Strong, unique password (never the demo value).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=propx
POSTGRES_PASSWORD=
POSTGRES_DB=propx_engine
# Host stays `db` (the compose service name) — do NOT point this at localhost.
DATABASE_URL=postgresql+psycopg://propx:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/propx_engine

# --- Redis (session memory) -------------------------------------------
# REQUIRED in production. Compose starts redis with --requirepass <this>, and
# the app authenticates via REDIS_URL. Redis is bound to 127.0.0.1 only.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
# Host stays `redis`. Keep the password here in sync with REDIS_PASSWORD above.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# ==========================================================================
#  LLM PROVIDER  (Constitution §12 — swap provider by config only)
#  Supported: mock | gemini | claude | openai | openrouter | ollama
#  Use a real provider in production (mock returns canned text).
# ==========================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
# REQUIRED when LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (only fill the one matching LLM_PROVIDER)
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================================================
#  EMBEDDINGS  (for RAG vector search)
#  Use a real provider so search quality matches production answers.
#  Dimension MUST match the vector column (768 = Gemini text-embedding-004).
# ==========================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- RAG tuning --------------------------------------------------------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# --- First-boot admin accounts ----------------------------------------
# REQUIRED: real addresses + strong passwords. The seeder refuses the demo
# defaults (admin123 / owner123) when APP_ENV=production. Change these
# passwords again from the UI after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
